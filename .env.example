# ════════════════════════════════════════════════════════════════
#  台股模擬交易系統 — 環境變數範本
#  使用方式：複製此文件為 .env，填入實際值
#  cp .env.example .env
#
#  ⚠ 安全須知：
#    1. .env 已加入 .gitignore，絕對不要 commit 進版本控制
#    2. 生產環境請使用 Secrets Manager，不要依賴 .env 文件
#    3. 此範本文件本身不含任何真實憑證，可安全 commit
# ════════════════════════════════════════════════════════════════


# ── 執行模式 ─────────────────────────────────────────────────────────────────
# true  = 模擬模式（使用虛擬帳戶，預設值，安全）
# false = 實戰模式（連接真實券商 API，需設定所有下方券商變數）
IS_SIMULATION=true

# 選擇券商（IS_SIMULATION=false 時才生效）
# 可選值：cathay（國泰×富果）| masterlink（元富）
BROKER=cathay


# ── Webhook 設定（可選，也可從網頁 UI 設定）───────────────────────────────────
# n8n Webhook URL（留空則停用通知）
WEBHOOK_URL=
# HMAC-SHA256 簽章密鑰（留空則不加簽章）
WEBHOOK_SECRET=


# ── 風險控管參數 ──────────────────────────────────────────────────────────────
# 單筆委託最大金額（元）；超過此金額的委託將被拒絕
MAX_ORDER_AMOUNT=500000
# 單筆委託最大股數
MAX_SHARES=10000
# 每日最大下單次數（防止程式 Bug 造成頻繁下單）
MAX_DAILY_ORDERS=20


# ════════════════════════════════════════════════════════════════
#  以下變數僅在 IS_SIMULATION=false 時需要設定
#  生產環境強烈建議使用 Secrets Manager 取代 .env 文件
# ════════════════════════════════════════════════════════════════


# ── 國泰證券 × 富果 Fugle Trade API ──────────────────────────────────────────
#
# 申請方式：
#   1. 至 https://developer.fugle.tw/ 申請開發者帳號
#   2. 綁定國泰證券帳號
#   3. 在後台「API 管理」建立 Key 並下載憑證
#
# 憑證安全規範：
#   ・憑證文件（.pfx）請存放在 /secrets/ 等程式碼目錄以外的路徑
#   ・憑證密碼使用以下方式管理（依安全需求由高到低）：
#       高：AWS Secrets Manager / Azure Key Vault / HashiCorp Vault
#       中：Kubernetes Secret / Docker Swarm Secret
#       低：.env 文件（僅限本機開發，加入 .gitignore）
#   ・憑證有效期通常為 1 年，建議設定 30 天前的更換提醒
#
FUGLE_API_KEY=your_fugle_api_key_here
FUGLE_API_SECRET=your_fugle_api_secret_here
# 憑證絕對路徑（不要放在專案目錄內）
# 範例：/home/user/.secrets/fugle_cert.pfx
#        C:\Users\User\.secrets\fugle_cert.pfx
FUGLE_CERT_PATH=/path/to/your/fugle_cert.pfx
# 憑證密碼（生產環境請改用 Secrets Manager）
FUGLE_CERT_PASSWORD=your_cert_password_here


# ── 元富證券 MasterLink API ───────────────────────────────────────────────────
#
# 申請方式：
#   1. 至元富證券開戶並申請 API 使用資格
#   2. 聯絡業務取得 SDK 與 API Key
#   3. 下載並安裝 masterlink-mq-py 套件
#
# 雙因子驗證（2FA）：
#   元富可能要求 OTP 驗證，請確認 API 帳號的驗證需求
#
ML_API_KEY=your_masterlink_api_key_here
ML_API_SECRET=your_masterlink_api_secret_here
ML_CERT_PATH=/path/to/your/masterlink_cert.pfx
ML_CERT_PASSWORD=your_cert_password_here
ML_ACCOUNT_ID=your_account_id_here
# 帳號登入密碼（僅用於初次取得 Token，建議設定後立即從 .env 移除）
ML_PASSWORD=


# ════════════════════════════════════════════════════════════════
